# Secrets only. Everything else lives in config.yaml (see config.example.yaml).

# Executor provider key (name set by executor.apiKeyEnv)
AI_MODEL_API_KEY=

# Vercel AI Gateway key, used by the System One router (Jev)
AI_GATEWAY_API_KEY=

# Postgres password (name set by postgres.passwordEnv)
PGPASSWORD=

# Optional: another config file, and where the UI listens
# CONFIG_FILE=config.yaml
# HOST=127.0.0.1
# PORT=3000
