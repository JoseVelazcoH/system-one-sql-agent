# Executor model (provider:model). Providers: openai (e.g. openai:gpt-4.1-mini)
# or openrouter (e.g. openrouter:openai/gpt-5.6-luna, needs an sk-or- key).
AI_MODEL=openai:gpt-4.1-mini
AI_MODEL_TEMPERATURE=0.1
AI_MODEL_API_KEY=

# Vercel AI Gateway key, used by the Jev router
AI_GATEWAY_API_KEY=

# Minimum Jev probability for a database to be passed to the executor
ROUTER_THRESHOLD=0.5
# Minimum Jev probability for a table to have its columns preloaded for the executor
TABLE_THRESHOLD=0.6
# Upper bound on preloaded tables, to keep the executor prompt small
MAX_PRELOADED_TABLES=6

# Postgres connection (the database name comes from the router)
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=

# Databases that must never be offered to the router (comma separated)
EXCLUDED_DATABASES=postgres,airflow,test_etl,copybench,pendientes
